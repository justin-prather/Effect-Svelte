{
  "name": "form-svelte",
  "version": "0.1.0",
  "description": "Svelte 5 bindings for @lucas-barake/effect-form — a type-safe form builder powered by Effect Schema",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.svelte"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@lucas-barake/effect-form": "^1.1.1"
  },
  "peerDependencies": {
    "atom-svelte": "workspace:^",
    "effect": "^4.0.5",
    "svelte": "^5.7.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "atom-svelte": "workspace:*",
    "effect": "^4.0.5",
    "jsdom": "^26.0.0",
    "svelte": "^5.56.4",
    "svelte-check": "^4.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
