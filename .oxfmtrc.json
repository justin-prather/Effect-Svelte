{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "references/**",
    "**/dist/**",
    "**/build/**",
    "**/.svelte-kit/**",
    "tools/oxlint/anti-slop/**"
  ],
  "semi": false,
  "singleQuote": false,
  "trailingComma": "none",
  "insertFinalNewline": true,
  "sortImports": true,
  "sortPackageJson": { "sortScripts": true },
  "overrides": [
    { "files": ["packages/**/*.svelte", "examples/**/*.svelte"], "options": { "svelte": true } }
  ]
}
